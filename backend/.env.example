# Backend Environment Variables Template
# Copy this file to .env and replace placeholders with real credentials.
# NEVER commit real .env files to version control.

# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=production

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cseducation?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# JWT Secret Key (Generate a cryptographically secure random string with at least 32 characters)
# Example generation in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_jwt_secret_key_here

# Allowed CORS Origin(s) (Comma-separated for multiple origins)
# Example: https://cseducation.vercel.app,http://localhost:5173
CORS_ORIGIN=https://your-frontend-domain.vercel.app
